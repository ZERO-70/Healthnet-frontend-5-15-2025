# Read automatically by Create React App for production builds (npm run build).
#
# This must live in a file rather than an inline env var: `npm run deploy` runs
# the `predeploy` hook, which re-runs `npm run build` in a fresh shell — an
# inline REACT_APP_API_BASE_URL=... is lost there, and the build silently falls
# back to the localhost default in src/constants/api.js.
REACT_APP_API_BASE_URL=https://healthnet-zair-7aa588192c75.herokuapp.com
